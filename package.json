{
    "name": "quadra-data",
    "version": "1.0.0",
    "description": "Quadra read layer: an off-chain index of the Flare markets plus the HTTP surface that serves it, so a screen never re-walks the chain in 30-block windows.",
    "license": "Apache-2.0",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsup && pnpm -r build",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit && pnpm -r typecheck",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "serve": "tsx src/serve.ts",
        "indexer": "tsx src/indexer/indexer.ts",
        "print-addresses": "tsx scripts/print-addresses.ts",
        "sandbox": "tsx sandbox/integration.ts",
        "pm2:serve": "pm2 start npm --name quadra-gateway -- run serve",
        "pm2:indexer": "pm2 start npm --name quadra-indexer -- run indexer"
    },
    "keywords": [
        "quadra",
        "flare",
        "indexer",
        "coston2"
    ],
    "engines": {
        "node": ">=20.12"
    },
    "dependencies": {
        "better-sqlite3": "^12.11.1",
        "fastify": "^5.8.5",
        "quadra-core": "file:./packages/core",
        "viem": "^2.21.0"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^22.0.0",
        "prettier": "^3.4.0",
        "tsup": "^8.5.0",
        "tsx": "^4.19.0",
        "typescript": "^5.7.0"
    }
}
