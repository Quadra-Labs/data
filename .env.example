# quadra-data — the read layer.
#
# Almost nothing here is required. Contract addresses are read from
# contracts/deployments/<chainId>.json, which the deploy script writes, so a redeploy needs no
# change to this file at all. Set a variable only to override that, or to point at a deployment
# you did not run.
#
# Precedence: an exported environment variable always beats this file. That is the opposite of
# Node's own loadEnvFile, and it is deliberate — a secret injected by pm2 or Docker must not be
# overwritten by a stale file on disk.

# --- chain ----------------------------------------------------------------------------------------

CHAIN_ID=114
CHAIN_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
EXPLORER_URL=https://coston2-explorer.flare.network

# Contract addresses. Leave unset to read contracts/deployments/<CHAIN_ID>.json.
# JOB_ESCROW=
# SEALED_COMPETITION=
# PASSPORT=
# TEE_REGISTRY=
# QUADRA_TOKEN=

# Where the deployments file lives, if the repos are not sibling checkouts.
# CONTRACTS_DIR=../contracts

# --- indexing -------------------------------------------------------------------------------------

# The block to start from. Leave unset and the indexer finds the deploy block by binary search over
# eth_getCode (about 25 requests, once) and caches it. Setting it to 0 explicitly means GENESIS,
# which on Coston2 is ~33.6 million blocks and over a million requests.
# FROM_BLOCK=

INDEXER_DB_PATH=quadra-index.db

# Blocks per eth_getLogs window. Coston2's public endpoint caps this at 30; raise it for a private
# node. The single most important tuning knob here.
LOG_CHUNK_BLOCKS=30

# How often to look for new blocks. Coston2 produces one every ~1.7s.
INDEXER_POLL_MS=4000

# How far behind the head the persisted cursor stays, so a reorg can be rewound rather than served.
CONFIRMATIONS=5

# Beyond this lag the index is treated as cold and reads fall back to the chain.
MAX_LAG_BLOCKS=200

# Set to 0 to run the gateway WITHOUT the indexer (a split deployment). They must then share the
# same INDEXER_DB_PATH on the same host — SQLite WAL is one writer and many readers, on one
# filesystem.
# INDEXER=1

# --- serving --------------------------------------------------------------------------------------

PORT=8787

# Tighten this in production. A wildcard is defensible here only because every route is a read.
DATA_CORS_ORIGIN=*

# How long a cached chain read is served before revalidating.
READ_CACHE_TTL_MS=30000

# --- oracle ---------------------------------------------------------------------------------------

# Flare's Data Availability layer. The public Coston2 endpoint needs no key.
DA_URL=https://ctn2-data-availability.flare.network
# DA_API_KEY=

# --- agents ---------------------------------------------------------------------------------------

# Each agent's on-chain wallet. Names and descriptions come from src/agents/catalog.json; these are
# what the chain actually knows. Per-agent on purpose: reputation is keyed by wallet, so agents
# sharing one key would share one Passport track and no leaderboard could separate them.
# AGENT=
# ETH_AGENT=
# SOL_AGENT=
